# ─────────────────────────────────────────────────────────────────────────────
# AfroMix — Environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/afromix"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-in-production-32-chars!!"

# ── Email (Resend — https://resend.com) ────────────────────────────────────────
# En dev sans clé : les URLs d'activation s'affichent dans la console
# Pour l'envoi réel : créez un compte gratuit sur https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# En test gratuit sans domaine : AfroMix <onboarding@resend.dev>
# Avec votre domaine personnalisé : AfroMix <noreply@votredomaine.com>
EMAIL_FROM="AfroMix <onboarding@resend.dev>"

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Storage (Cloudflare R2 or AWS S3) ─────────────────────────────────────────
# For AWS S3: leave STORAGE_ENDPOINT empty (undefined)
# For Cloudflare R2: set STORAGE_ENDPOINT to your R2 endpoint

STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_BUCKET="afromix"

# Public CDN URL (Cloudflare R2 custom domain or CloudFront)
STORAGE_CDN_URL="https://cdn.afromix.io"

# ── Stripe (optional — for subscriptions) ─────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
